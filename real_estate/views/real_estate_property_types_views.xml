<?xml version="1.0"?>

<odoo>
    <record id="real_estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">real.estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="real_estate_property_type_view_list" model="ir.ui.view">
        <field name="name">real.estate.property.type.list</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <list string="Property Types">
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="real_estate_property_type_view_form" model="ir.ui.view">
        <field name="name">real.estate.property.type.form</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1 class="mb32">
                            <field name="name" class="mb16"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>